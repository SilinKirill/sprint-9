{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "source-db",
  "database.port": "5432",
  "database.user": "crm_cdc",
  "database.password": "${file:/run/cdc/credentials.properties:password}",
  "database.dbname": "sources",
  "topic.prefix": "bionicpro",
  "plugin.name": "pgoutput",
  "slot.name": "bionicpro_crm",
  "slot.drop.on.stop": "false",
  "publication.name": "bionicpro_crm",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "crm.clients,crm.prostheses,crm.cdc_heartbeat",
  "snapshot.mode": "initial",
  "provide.transaction.metadata": "true",
  "tombstones.on.delete": "false",
  "heartbeat.interval.ms": "5000",
  "heartbeat.action.query": "UPDATE crm.cdc_heartbeat SET checked_at = clock_timestamp() WHERE id = 1",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "route",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "bionicpro\\.crm\\..*",
  "transforms.route.replacement": "bionicpro.crm_events"
}
